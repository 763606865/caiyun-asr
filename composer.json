{
    "name": "caiyun/asr",
    "description": "彩云语音识别服务，统一封装腾讯云、科大讯飞、阿里云一句话识别",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "刘骏霖",
            "email": "763606865@qq.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.29",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "Caiyun\\Asr\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Caiyun\\Asr\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "pint": "@php vendor/bin/pint --test src config tests",
        "pint:fix": "@php vendor/bin/pint src config tests",
        "phpstan": "@php vendor/bin/phpstan analyse --no-progress --memory-limit=512M",
        "test": "@php vendor/bin/phpunit",
        "check": ["@pint", "@phpstan", "@test"]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Caiyun\\Asr\\AsrServiceProvider"
            ]
        }
    }
}
